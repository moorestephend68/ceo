+function filmPhase(t) {
+  let acc = 0;
+  for (const [name, len] of Object.entries(FILM.T)) {
+    if (t < acc + len) return { name, u: (t - acc) / len };
+    acc += len;
+  }
+  return { name: 'stockout', u: 1 };
+}
