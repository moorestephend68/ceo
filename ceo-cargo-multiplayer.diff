+        }
+      });
+    };
+    v.block.grades.forEach((g, j) => {
+      const sl = document.getElementById('bid' + j);
+      if (sl) sl.addEventListener('input', (e) => { S.bids[j] = Number(e.target.value); paint(); });
+    });
+    paint();
+  }
+  poll(8000);
+}
+
+/* ---- stage two: the manifests are out ----------------------------------- */
+function screenRoute(app, dock, v) {
+  const you = v.you, b = v.board;
+  app.insertAdjacentHTML('beforeend', head(v));
+
+  let m = `<div class="card"><h2>Manifests filed</h2><table>
+    <tr><th>Captain</th><th>Loading</th><th>Could sell at</th></tr>`;
+  (v.manifests || []).forEach((x) => {
+    m += `<tr class="${x.you ? 'you' : ''}"><td>${x.you ? 'You' : x.name}</td>
