+  if (!FILM.data) return;
+  const dpr = Math.min(2, window.devicePixelRatio || 1);
+  FW = FILM.reel.clientWidth; FH = FILM.reel.clientHeight;
+  FILM.reel.width = Math.round(FW * dpr); FILM.reel.height = Math.round(FH * dpr);
+  FILM.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
