+    g.fillStyle = c.dim;
+    g.font = `${Math.min(10.5, col.w * 0.2)}px system-ui,sans-serif`;
+    g.fillText((f.you ? 'You' : f.name.split(' ')[0]).slice(0, 11), col.x + col.w / 2, y + 42);
