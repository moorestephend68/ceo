+  app.appendChild(step);
+
+  const ready = S.sel.d !== undefined;
+  const d = $(`<div class="inner">
+    <div class="fc"><small>${ready ? 'With the market to yourself' : 'Pick a station'}</small>
+      <span class="v ${ready?'':'muted'}">${ready ? b.drop[S.sel.d].name.split(' ')[0] : '—'}</span></div>
+    <button class="go" ${ready?'':'disabled'}>File the route</button></div>`);
+  d.querySelector('.go').onclick = async () => {
+    if (!ready || S.busy) return;
+    S.busy = true;
+    try {
+      const out = await api('cargo/route', { drop: S.sel.d });
+      S.sel = {}; S.busy = false;
+      /* filing last closes the round, so the film may start the moment the
+         button is released — which is the good version of waiting */
+      return applyView(out.view);
+    } catch (e) { S.error = e.message; }
+    S.busy = false; render();
+  };
+  dock.appendChild(d);
+  poll(8000);
+}
+
+function screenOver(app, dock, v) {
+  const fin = [...v.seats].sort((a, b) => b.cash - a.cash);
+  const place = fin.findIndex((s) => s.you) + 1;
+  app.insertAdjacentHTML('beforeend', head(v));
+  app.insertAdjacentHTML('beforeend', `<div class="card"><h2>${v.rounds} rounds done</h2>
+    <div class="big">${['','First','Second','Third','Fourth','Fifth'][place] || place}</div></div>`);
+  let t = `<div class="card"><h2>Final</h2><table>
+    <tr><th>Captain</th><th>Ship</th><th>On parts</th><th>Cash</th></tr>`;
+  fin.forEach((s) => { t += `<tr class="${s.you?'you':''}"><td>${s.name}</td>
+    <td>${s.ship}%</td><td class="muted">${money(s.onParts||0)}</td>
+    <td>${money(s.cash)}</td></tr>`; });
+  app.insertAdjacentHTML('beforeend', t + `</table>
+    <p class="note" style="margin-top:10px">The best ship wins about one season in five — a
+    contested auction prices quality at close to what it is worth, so the captain who wins is
+    the one who got a decent ship <b>cheaply</b>.</p></div>`);
+  const d = $(`<div class="inner"><button class="go">Another table</button></div>`);
+  d.querySelector('.go').onclick = () => {
+    S = { code: null, token: null, view: null, sel: {}, bids: [], busy: false, error: null, name: S.name };
+    try { localStorage.removeItem(KEY); } catch {}
+    render();
+  };
+  dock.appendChild(d);
+}
+
+/* ======================================================================
+   THE RESOLUTION, WATCHED
+
+   Everything below draws one round that has already happened. It is handed
+   the `replay` block the server recorded while settling — where each ship
+   started, what it carried, what the market did to it, and every bid in the
+   yard — and it never works anything out for itself. A drawing that recomputes
+   the economy is a second copy of the economy waiting to disagree with the
+   first, and this page has gone to some trouble not to have one.
+
+   The clock is the only state. Every position, every number and every panel is
+   a pure function of it, which is what makes Skip a one-liner rather than an
+   unwinding.
+   ====================================================================== */
+const FILM = {
+  T: { out: 2.4, load: 1.2, run: 2.7, market: 2.0, yard: 3.8 },
+  reel: null, ctx: null, t: 0, raf: 0, data: null, view: null, done: null,
+};
+FILM.LEN = Object.values(FILM.T).reduce((a, b) => a + b, 0);
+const GOOD_COLOUR = ['#8b9bb4','#d8c47a','#5fd08a','#7fd4ff','#c98fe0'];
+const fease = (u) => u < 0.5 ? 4*u*u*u : 1 - Math.pow(-2*u + 2, 3) / 2;
+const f01 = (u) => Math.max(0, Math.min(1, u));
+const flerp = (a, b, u) => a + (b - a) * u;
+
+function filmPhase(t) {
+  let acc = 0;
+  for (const [name, len] of Object.entries(FILM.T)) {
+    if (t < acc + len) return { name, u: (t - acc) / len };
+    acc += len;
+  }
+  return { name: 'yard', u: 1 };
+}
+
+/* Only ever plays a round you were actually at, and only once — a refresh or a
+   second tab should not replay a week you have already watched. */
+function maybePlayFilm(view) {
+  const h = (view.history || [])[0];
+  if (!h || !h.replay) return false;
+  /* Once per browser rather than once per tab: reloading the page should not
+     replay a week you have already watched, and a second tab should not play it
+     at you again. */
+  let seen = 0;
+  try { seen = Number(localStorage.getItem('cargo.seen.' + view.code) || 0); } catch {}
+  if (h.replay.round <= seen) return false;
+  try { localStorage.setItem('cargo.seen.' + view.code, String(h.replay.round)); } catch {}
+  playFilm(view, h.replay);
+  return true;
+}
+
+function playFilm(view, data) {
+  FILM.data = data; FILM.view = view; FILM.t = 0;
+  const wrap = document.getElementById('film');
+  wrap.hidden = false;
+  FILM.reel = document.getElementById('reel');
+  FILM.ctx = FILM.reel.getContext('2d');
+  filmLayout();
+  document.getElementById('skip').onclick = endFilm;
+  FILM.reel.onclick = endFilm;
+  let last = performance.now();
+  const step = (now) => {
+    const dt = Math.min(0.05, (now - last) / 1000); last = now;
+    FILM.t += dt;
+    if (FILM.t >= FILM.LEN) return endFilm();
+    drawFilm();
+    FILM.raf = requestAnimationFrame(step);
+  };
+  FILM.raf = requestAnimationFrame(step);
+}
+function endFilm() {
+  cancelAnimationFrame(FILM.raf);
+  document.getElementById('film').hidden = true;
+  FILM.data = null;
+  render();
+}
+
+let FW = 0, FH = 0, FPAD = { x: 0, y: 0 }, FSCALE = 1;
+function filmLayout() {
+  const dpr = Math.min(2, window.devicePixelRatio || 1);
+  FW = FILM.reel.clientWidth; FH = FILM.reel.clientHeight;
+  FILM.reel.width = Math.round(FW * dpr); FILM.reel.height = Math.round(FH * dpr);
+  FILM.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+  const top = 62;
+  const usable = Math.min(FW - 20, FH - top - 230);
+  FSCALE = usable / 100;
+  FPAD = { x: (FW - usable) / 2, y: top };
+}
+window.addEventListener('resize', () => { if (FILM.data) filmLayout(); });
+const fx = (x) => FPAD.x + x * FSCALE;
+const fy = (y) => FPAD.y + y * FSCALE;
+
+const FSTARS = (() => {
+  let s = 987654;
+  const r = () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296;
+  return Array.from({ length: 180 }, () => ({ x: r(), y: r(), z: 0.3 + r() * 0.7 }));
+})();
+
+function filmShip(d, i, ph) {
+  const b = FILM.view.board;
+  const from = b.drop[d.at[i]], to = b.pick[d.declared[i].p], end = b.drop[d.rows[i].d];
+  let a = from, z = to, u = 0, flying = false, face = to;
+  if (ph.name === 'out') { u = fease(ph.u); flying = true; }
+  else if (ph.name === 'load') { a = to; z = to; face = end; }
+  else if (ph.name === 'run') { a = to; z = end; u = fease(ph.u); flying = true; face = end; }
+  else if (ph.name !== 'out') { a = end; z = end; face = null; }
+  const ref = face || to;
+  const ang = (a === z) ? Math.atan2(ref.y - a.y, ref.x - a.x) || 0
+                        : Math.atan2(z.y - a.y, z.x - a.x);
+  return { x: flerp(a.x, z.x, u), y: flerp(a.y, z.y, u), ang, flying, a, b: z, u };
+}
+
+function drawFilm() {
+  const g = FILM.ctx, d = FILM.data, v = FILM.view, t = FILM.t;
+  const me = v.seats.findIndex((s) => s.you);
+  const ph = filmPhase(t);
+  g.fillStyle = '#070b12'; g.fillRect(0, 0, FW, FH);
+
+  for (const s of FSTARS) {
+    const x = FPAD.x + ((s.x * 110 + (t * 2 * s.z) % 110) % 110 - 5) * FSCALE;
+    const y = FPAD.y + s.y * 100 * FSCALE;
+    if (x < FPAD.x - 4 || x > FPAD.x + 100 * FSCALE + 4) continue;
+    g.fillStyle = `rgba(200,220,255,${(0.1 + 0.45 * s.z).toFixed(3)})`;
+    g.fillRect(x, y, s.z * 1.6, s.z * 1.6);
+  }
+
+  /* the lanes, then the places */
+  const b = v.board;
+  g.lineWidth = 1; g.strokeStyle = 'rgba(90,120,170,0.10)';
+  b.pick.forEach((p) => { for (const q of b.reachD[p.i]) {
+    const st = b.drop[q];
+    g.beginPath(); g.moveTo(fx(p.x), fy(p.y)); g.lineTo(fx(st.x), fy(st.y)); g.stroke(); } });
+  b.pick.forEach((p) => {
+    const busy = d.rows.filter((r) => r.p === p.i).length;
+    g.beginPath(); g.arc(fx(p.x), fy(p.y), 1.2 * FSCALE, 0, 7);
+    g.fillStyle = busy ? '#3d5580' : '#22304a'; g.fill();
+  });
+  b.drop.forEach((st) => {
+    const sz = 2.4 * FSCALE;
+    g.save(); g.translate(fx(st.x), fy(st.y)); g.rotate(Math.PI / 4);
+    g.fillStyle = '#2b3a55'; g.fillRect(-sz/2, -sz/2, sz, sz); g.restore();
+    g.fillStyle = 'rgba(230,237,247,0.55)';
+    g.font = `${Math.max(9, 3.1 * FSCALE)}px ui-sans-serif,sans-serif`;
+    g.textAlign = 'center';
+    g.fillText(st.name.split(' ')[0], fx(st.x), fy(st.y) - 3 * FSCALE);
+  });
+
+  /* the ships */
+  for (let i = v.seats.length - 1; i >= 0; i--) {
+    const mine = i === me;
+    const st = filmShip(d, i, ph);
+    const x = fx(st.x), y = fy(st.y), size = (mine ? 2.1 : 1.8) * FSCALE;
+    if (st.flying && st.u > 0.01) {
+      const back = Math.min(0.28, st.u);
+      const tx = fx(flerp(st.a.x, st.b.x, st.u - back)), ty = fy(flerp(st.a.y, st.b.y, st.u - back));
+      const grd = g.createLinearGradient(tx, ty, x, y);
+      grd.addColorStop(0, 'rgba(0,0,0,0)');
+      grd.addColorStop(1, mine ? 'rgba(242,193,78,0.55)' : 'rgba(127,147,181,0.32)');
+      g.strokeStyle = grd; g.lineWidth = mine ? 2.4 : 1.6; g.lineCap = 'round';
+      g.beginPath(); g.moveTo(tx, ty); g.lineTo(x, y); g.stroke();
+    }
+    g.save(); g.translate(x, y); g.rotate(st.ang);
+    if (mine) { g.shadowColor = 'rgba(242,193,78,0.8)'; g.shadowBlur = 12; }
+    g.beginPath();
+    g.moveTo(size, 0); g.lineTo(-size * 0.7, size * 0.62);
+    g.lineTo(-size * 0.35, 0); g.lineTo(-size * 0.7, -size * 0.62);
+    g.closePath(); g.fillStyle = mine ? '#f2c14e' : '#7f93b5'; g.fill();
+    g.shadowBlur = 0;
+    if (ph.name === 'run' || ph.name === 'market') {
+      g.beginPath(); g.arc(-size * 0.25, 0, size * 0.38, 0, 7);
+      g.fillStyle = GOOD_COLOUR[d.rows[i].c]; g.fill();
+    }
+    g.restore();
+    if (ph.name === 'out' || ph.name === 'load') {
+      g.fillStyle = mine ? 'rgba(242,193,78,0.95)' : 'rgba(150,170,200,0.7)';
+      g.font = `${Math.max(8, 2.7 * FSCALE)}px ui-sans-serif,sans-serif`;
+      g.textAlign = 'center';
+      g.fillText(mine ? 'YOU' : d.names[i].split(' ')[0], x, y - size - 4);
+    }
+  }
+
+  /* the crowd, which is the whole game in one label */
+  const crowd = (keyOf, placeOf, dy, word, pct) => {
+    const by = new Map();
+    d.rows.forEach((r, i) => { const k = keyOf(r); by.set(k, (by.get(k) || []).concat(r)); });
+    for (const [, rows] of by) {
+      if (rows.length < 2) continue;
+      const p = placeOf(rows[0]);
+      filmFlash(fx(p.x), fy(p.y) + dy, `${rows.length} ${word} · ${pct(rows[0])}`, '#ff7a6b', ph.u);
+    }
+  };
+  if (ph.name === 'load')
+    crowd((r) => r.p + ':' + r.c, (r) => b.pick[r.p], -5 * FSCALE, 'buying',
+          (r) => Math.round((r.paid / d.prices.buy[r.p][r.c] - 1) * 100) + '% dearer');
+  if (ph.name === 'market')
+    crowd((r) => r.d + ':' + r.c, (r) => b.drop[r.d], 5 * FSCALE, 'selling',
+          (r) => Math.round((1 - r.got / d.prices.sell[r.d][r.c]) * 100) + '% less');
+
+  /* what each captain made, stacked so a busy station stays readable */
+  if (ph.name === 'market') {
+    const byStation = new Map();
+    d.rows.forEach((r, i) => byStation.set(r.d, (byStation.get(r.d) || []).concat({ r, i })));
+    for (const [d0, list] of byStation) {
+      const st = b.drop[d0];
+      list.sort((a, z) => z.r.profit - a.r.profit);
+      list.forEach(({ r, i }, k) => {
+        g.save();
+        g.globalAlpha = f01(1.6 - ph.u * 1.6);
+        g.font = `600 ${Math.max(11, (i === me ? 4.2 : 3.1) * FSCALE)}px ui-sans-serif,sans-serif`;
+        g.textAlign = 'center';
+        g.fillStyle = r.profit >= 0 ? '#5fd08a' : '#ff7a6b';
+        g.fillText((r.profit >= 0 ? '+' : '−') + '$' + Math.abs(r.profit).toLocaleString(),
+          fx(st.x), fy(st.y) - fease(f01(ph.u * 1.4)) * 4 * FSCALE - (2.4 + k * 2.1) * FSCALE);
+        g.restore();
+      });
+    }
+  }
+
+  filmBoard(d, ph, me);
+  filmHUD(d, ph, me);
+  if (ph.name === 'yard') filmYard(d, ph, me);
+}
+
+function filmFlash(x, y, text, colour, u) {
+  const g = FILM.ctx;
+  g.save();
+  g.globalAlpha = f01(Math.sin(f01(u) * Math.PI) * 1.6);
+  g.font = `600 ${Math.max(10, 3.0 * FSCALE)}px ui-sans-serif,sans-serif`;
+  g.textAlign = 'center';
+  const w = g.measureText(text).width + 14;
+  const cx = Math.max(w / 2 + 8, Math.min(FW - w / 2 - 8, x));
+  g.fillStyle = 'rgba(10,14,23,0.85)';
+  g.beginPath(); g.roundRect(cx - w/2, y - 11, w, 20, 6); g.fill();
+  g.strokeStyle = colour; g.lineWidth = 1; g.stroke();
+  g.fillStyle = colour; g.fillText(text, cx, y + 4);
+  g.restore();
+}
+
+/* the band under the square map, which is where the table lives */
+function filmBoard(d, ph, me) {
+  const g = FILM.ctx;
+  const y0 = FPAD.y + 100 * FSCALE + 16, y1 = FH - 104;
+  if (y1 - y0 < 60) return;
+  const rowH = Math.min(34, (y1 - y0 - 22) / d.rows.length);
+  const takings = ph.name === 'market' || ph.name === 'yard';
+  g.save();
+  g.textAlign = 'left'; g.fillStyle = '#5a6d8c';
+  g.font = '600 10px ui-sans-serif,sans-serif';
+  g.fillText(takings ? 'WHAT THEY MADE' : 'MANIFESTS FILED', 18, y0 + 8);
+  const order = d.rows.map((r, i) => i)
+    .sort((a, z) => (takings ? d.rows[z].profit - d.rows[a].profit : a - z));
+  order.forEach((i, k) => {
+    const y = y0 + 22 + k * rowH + rowH * 0.62, r = d.rows[i], mine = i === me;
+    if (mine) {
+      g.fillStyle = 'rgba(242,193,78,0.07)';
+      g.beginPath(); g.roundRect(12, y - rowH * 0.62, FW - 24, rowH - 2, 6); g.fill();
+    }
+    g.fillStyle = mine ? '#f2c14e' : '#7f93b5';
+    g.font = `${mine ? 600 : 400} 12px ui-sans-serif,sans-serif`;
+    g.textAlign = 'left';
+    g.fillText(mine ? 'You' : d.names[i].split(' ')[0], 18, y);
+    g.beginPath(); g.arc(104, y - 4, 4, 0, 7); g.fillStyle = GOOD_COLOUR[r.c]; g.fill();
+    g.fillStyle = mine ? '#e6edf7' : '#5a6d8c';
+    g.font = '12px ui-sans-serif,sans-serif';
+    g.fillText(GOODS[r.c], 114, y);
+    g.textAlign = 'right';
+    if (takings) {
+      g.fillStyle = r.profit >= 0 ? '#5fd08a' : '#ff7a6b';
+      g.font = '600 12px ui-sans-serif,sans-serif';
+      g.fillText((r.profit >= 0 ? '+' : '−') + '$' + Math.abs(r.profit).toLocaleString(), FW - 18, y);
+      g.fillStyle = '#4a5d7c'; g.font = '11px ui-sans-serif,sans-serif';
+      g.fillText(FILM.view.board.drop[r.d].name.split(' ')[0], FW - 96, y);
+    } else {
+      g.fillStyle = '#4a5d7c'; g.font = '11px ui-sans-serif,sans-serif';
+      g.fillText('at ' + FILM.view.board.pick[r.p].name, FW - 18, y);
+    }
+  });
+  g.restore();
+}
+
+function filmHUD(d, ph, me) {
+  const g = FILM.ctx;
+  g.textAlign = 'left'; g.fillStyle = '#5a6d8c';
+  g.font = '600 11px ui-sans-serif,sans-serif';
+  g.fillText(`ROUND ${d.round}`, 16, 30);
+  let shown = d.before.cash[me];
+  if (ph.name === 'market') shown = flerp(d.before.cash[me], d.after.cash[me], fease(ph.u));
+  else if (ph.name === 'yard') shown = d.after.cash[me];
+  g.textAlign = 'right'; g.fillStyle = '#e6edf7';
+  g.font = '600 22px ui-sans-serif,sans-serif';
+  g.fillText('$' + Math.round(shown).toLocaleString(), FW - 16, 32);
+  g.fillStyle = '#5a6d8c'; g.font = '11px ui-sans-serif,sans-serif';
+  const hold = ph.name === 'yard'
+    ? flerp(d.before.hold[me], d.after.hold[me], fease(f01(ph.u * 1.6))) : d.before.hold[me];
+  g.fillText('hold ' + Math.round(hold) + ' units', FW - 16, 48);
+  if (ph.name === 'run' || ph.name === 'market') {
+    const r = d.rows[me];
+    g.textAlign = 'left'; g.fillStyle = GOOD_COLOUR[r.c];
+    g.font = '600 12px ui-sans-serif,sans-serif';
+    g.fillText(r.load + ' ' + GOODS[r.c] + ' → ' + FILM.view.board.drop[r.d].name, 16, 50);
+  }
+}
+
+function filmYard(d, ph, me) {
+  const g = FILM.ctx;
+  const lots = d.refit.lots, rowH0 = 46;
+  const panelH = Math.min(FH * 0.44, 46 + lots.length * rowH0);
+  const top = FH - 108 - panelH * fease(f01(ph.u * 6));
+  g.save();
+  g.fillStyle = '#0d1420';
+  g.beginPath(); g.roundRect(10, top, FW - 20, panelH, 14); g.fill();
+  g.strokeStyle = '#22304a'; g.lineWidth = 1; g.stroke();
+  g.fillStyle = '#5a6d8c'; g.font = '600 11px ui-sans-serif,sans-serif'; g.textAlign = 'left';
+  g.fillText('THE YARD · ' + SLOTNAMES[d.block.failed[me]].toUpperCase() + ' FAILED', 24, top + 22);
+  const rowH = (panelH - 44) / lots.length;
+  const opening = f01((ph.u - 0.12) / 0.7) * lots.length;
+  lots.forEach((l, j) => {
+    const y = top + 38 + j * rowH, open = f01(opening - j), mineWon = l.who === me;
+    g.globalAlpha = 0.35 + 0.65 * f01(opening - j + 0.6);
+    g.fillStyle = mineWon && open > 0.9 ? 'rgba(242,193,78,0.10)' : 'rgba(255,255,255,0.03)';
+    g.beginPath(); g.roundRect(18, y, FW - 36, rowH - 6, 8); g.fill();
+    g.textAlign = 'left'; g.fillStyle = '#e6edf7'; g.font = '13px ui-sans-serif,sans-serif';
+    g.fillText(`Lot ${j + 1} · ${Math.round(100 * l.grade)}%`, 28, y + rowH / 2 - 1);
+    if (open > 0.05) {
+      const bids = l.bids.map((bd, i) => ({ bd, i })).filter((x) => x.bd !== null && x.bd > 0)
+        .sort((a, z) => z.bd - a.bd);
+      g.font = '11px ui-sans-serif,sans-serif';
+      let bx = 28; g.globalAlpha = open;
+      for (const { bd, i } of bids.slice(0, 5)) {
+        const label = (i === me ? 'you' : d.names[i].split(' ')[0]) + ' $' + bd.toLocaleString();
+        g.fillStyle = i === l.who ? '#f2c14e' : '#5a6d8c';
+        g.fillText(label, bx, y + rowH / 2 + 13);
+        bx += g.measureText(label).width + 12;
+        if (bx > FW - 60) break;
+      }
+      g.textAlign = 'right'; g.font = '600 13px ui-sans-serif,sans-serif';
+      g.fillStyle = l.who < 0 ? '#5a6d8c' : mineWon ? '#f2c14e' : '#8296b4';
+      g.fillText(l.who < 0 ? 'unsold'
+        : (l.who === me ? 'YOURS' : d.names[l.who].split(' ')[0]) +
+          (l.paid > 0 ? ' · $' + l.paid.toLocaleString() : ' · free'),
+        FW - 30, y + rowH / 2 - 1);
+    }
+    g.globalAlpha = 1;
+  });
+  g.restore();
+}
+
+/* ------------------------------------------------------------------ start */
+(async () => {
+  const saved = load();
+  /* a code in the address bar wins over whatever was last played here, so a
+     link a friend sends does what it looks like it does */
+  const fromUrl = (location.pathname.match(/\/c\/([A-Za-z0-9]{4,8})/) || [])[1];
+  if (fromUrl) { S.code = fromUrl.toUpperCase(); }
+  else if (saved.code) { S.code = saved.code; S.token = saved.token; }
+  if (S.code && S.token) { await refresh(); poll(5000); }
+  else render();
+})();
+</script>
+</body>
+</html>
diff --git a/public/live.html b/public/live.html
index ff6da6f..f27872d 100644
--- a/public/live.html
+++ b/public/live.html
@@ -221,6 +221,122 @@
     /* The bar already says "If the round ran now" two lines above. */
     .projsheet .card > h2{display:none}
   }
+
+  /* ------------------------------------------------- filing on a phone
+
+     A slider gets about 230px next to its number box on a 390px screen. Price
+     runs from half the product's value to 1.6× it in 50c steps — roughly 220
+     stops across those 230px, so one pixel is one step and nobody can aim it.
+     Turned on its side in a sheet the same control gets 455px and a 56px thumb:
+     2.3× the resolution, and the forecast stays on screen underneath so the
+     price that makes the most money can be found by thumb rather than by
+     arithmetic.
+
