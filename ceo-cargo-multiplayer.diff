+/* The round, turned into people. Built once when the film starts rather than
+   per frame, so a pile is stable and a resize does not reshuffle the crowd. */
+function filmDataFor(v) {
+  if (!v || !v.history || !v.history.length) return null;
+  const h = v.history[v.history.length - 1];
+  const youId = v.you && v.you.seatId;
+  /* who ran out, from the same public flag the market table reads */
+  const ranOut = {};
+  for (const m of (v.market || [])) {
+    ranOut[m.seatId] = !!(m.pub || []).some((p) => p.stockoutLast);
+  }
