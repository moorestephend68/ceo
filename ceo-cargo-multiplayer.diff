+    const turned = you && r.demand > r.sales + 0.5 ? Math.round(r.demand - r.sales) : 0;
+    return {
+      seatId: r.seatId, name: r.name, price: r.price, share: r.share, you, turned,
+      turnedFrac: turned && r.demand ? turned / r.demand : 0,
+      out: !!ranOut[r.seatId],
+    };
+  });
