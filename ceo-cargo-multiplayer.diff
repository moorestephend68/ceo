+  const round = v.history[v.history.length - 1].round;
+  let seen = 0;
+  try { seen = Number(localStorage.getItem('ceo.seen.' + v.code) || 0); } catch {}
+  /* A round you were not at is not a reveal, it is a stale cutscene. The first
+     time this page lays eyes on a game that already has rounds behind it — a
