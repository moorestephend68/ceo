+  }
+
+  if (you.routed) {
+    app.insertAdjacentHTML('beforeend', `<div class="card"><h2>Filed</h2>
+      <p class="note">Selling at ${b.drop[you.routed.d].name}. Waiting for
+      ${v.seats.filter((s) => !s.filed).length} more.</p></div>`);
+    poll(3000);
+    return;
+  }
+
+  S.sel = { p: you.declared.p, c: you.declared.c, d: S.sel.d };
+  app.insertAdjacentHTML('beforeend', mapSVG(v));
+  const step = $(`<div class="step" data-step="port"><div class="lab"><span class="n">4</span>
+    &nbsp;Sell it at</div><div class="opts"></div></div>`);
+  b.reachD[you.declared.p].forEach((d) => {
+    const btn = $(`<button class="opt" aria-pressed="${S.sel.d === d}">
+      <span class="nm">${b.drop[d].name}</span>
+      <span class="px">${px(v.prices.sell[d][you.declared.c])}</span></button>`);
