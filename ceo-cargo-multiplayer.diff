+
+let S = { code: null, token: null, view: null, sel: {}, bids: [], busy: false, error: null };
+const save = () => { try { localStorage.setItem(KEY, JSON.stringify({ code: S.code, token: S.token })); } catch {} };
+const load = () => { try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch { return {}; } };
+
+/* Signing in is CEO's, not this page's. Hosting a private table is the thing
+   that was bought, so the server checks it — which means this page has to send
+   whatever session the site already has. Supabase keeps it under a key of its
+   own; locally there is no Supabase and a token can be dropped into
+   ceo.dev.token instead, exactly as live.html does. */
+function bearer() {
+  try {
+    const dev = localStorage.getItem('ceo.dev.token');
+    if (dev) return dev;
+    for (let i = 0; i < localStorage.length; i++) {
+      const k = localStorage.key(i);
+      if (!/^sb-.*-auth-token$/.test(k)) continue;
+      const v = JSON.parse(localStorage.getItem(k));
+      if (v && v.access_token) return v.access_token;
+    }
+  } catch {}
+  return null;
+}
+
+async function api(route, body) {
+  const url = '/api/' + route + (S.code ? (route.includes('?') ? '&' : '?') + 'code=' + S.code
+    + (S.token ? '&token=' + S.token : '') : '');
+  const headers = {};
+  const tok = bearer();
+  if (tok) headers.authorization = 'Bearer ' + tok;
+  if (body) headers['content-type'] = 'application/json';
+  const r = await fetch(url, body ? { method: 'POST', headers, body: JSON.stringify(body) }
+                                  : { headers });
+  const out = await r.json().catch(() => ({}));
+  if (!r.ok) throw new Error(out.error || 'Something went wrong.');
+  return out;
+}
+
+/* Polling, not sockets. A round closes when the last captain files or when the
+   clock runs out, and either way the next request notices — so the page only
+   has to ask. Slow while it is your move, brisk while you are waiting on
+   somebody else, and stopped when the tab is hidden. */
+let timer = null;
+function poll(ms) {
+  clearTimeout(timer);
+  if (document.hidden) return;
+  timer = setTimeout(async () => {
+    try { const out = await api('cargo/view'); applyView(out.view); } catch {}
+    poll(ms);
+  }, ms);
+}
+document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
+
+/* Every view arrives here. If it carries a round nobody has watched yet, the
+   film plays and the screen underneath is drawn when it finishes — so the
+   resolution is the default and the table is one tap away, rather than a
+   twelve-second cutscene standing between a captain and their next decision. */
+function applyView(v) {
+  S.view = v;
+  if (maybePlayFilm(v)) return;
+  render();
+}
+
+async function refresh() {
+  if (!S.code) return render();
+  try { const out = await api('cargo/view'); return applyView(out.view); }
+  catch (e) { S.error = e.message; }
+  render();
+}
+
+/* ------------------------------------------------------------------ screens */
+function render() {
+  const app = document.getElementById('app'), dock = document.getElementById('dock');
+  app.innerHTML = ''; dock.innerHTML = '';
+  const v = S.view;
+  if (!S.code || !v) return screenHome(app, dock);
+  if (v.status === 'lobby') return screenLobby(app, dock, v);
+  if (v.status === 'over') return screenOver(app, dock, v);
+  if (v.stage === 'declare') return screenDeclare(app, dock, v);
+  return screenRoute(app, dock, v);
+}
+
+function head(v) {
+  const you = v.seats.find((s) => s.you) || {};
+  const rank = [...v.seats].sort((a, b) => b.cash - a.cash).findIndex((s) => s.you) + 1;
+  const left = v.deadline ? Math.max(0, Math.round((Date.parse(v.deadline) - Date.now()) / 1000)) : null;
+  const clock = left === null ? 'no clock'
+    : left > 90 ? Math.round(left / 60) + ' min left'
+    : left + 's left';
+  return `<header><h1>Cargo Run</h1>
+    <div class="sub">${v.stage === 'declare' ? 'Manifests close' : 'Stations close'} · ${clock}</div>
+    <div class="bar">
+      <div>Round<b>${Math.min(v.round, v.rounds)} of ${v.rounds}</b></div>
+      <div>Cash<b>${money(you.cash || 0)}</b></div>
+      <div>Hold<b>${you.hold || 0}</b></div>
+      <div>Place<b>${rank} of ${v.seats.length}</b></div>
+    </div></header>`;
+}
+
+function screenHome(app, dock) {
+  app.insertAdjacentHTML('beforeend', `<header><h1>Cargo Run</h1>
+    <div class="sub">Five captains, one galaxy, eight runs</div></header>
+    <div class="card"><p class="note">Every round opens in the yard: a part of your ship has
+    failed and four replacements go under the hammer, one sealed bid each. Then you load,
+    everybody's manifest is published, and you choose where to sell — knowing what the others
+    are carrying but not where they are taking it.</p></div>`);
+  if (S.error) app.insertAdjacentHTML('beforeend', `<p class="err">${S.error}</p>`);
+
+  const n = $(`<div class="step"><div class="lab">Your outfit</div>
+    <input type="text" id="name" maxlength="24" placeholder="Halloran Freight"
+      value="${(S.name || '').replace(/"/g, '&quot;')}" style="letter-spacing:0"></div>`);
+  app.appendChild(n);
+
+  const c = $(`<div class="step"><div class="opts"></div></div>`);
+  const now = $(`<button class="opt tall"><span class="nm">Play now
+    <br><span class="meta">Seated with strangers. Starts within 90 seconds — empty seats
+    are filled.</span></span></button>`);
+  now.onclick = () => start('cargo/public/join');
+  const friends = $(`<button class="opt tall"><span class="nm">Play with friends
+    <br><span class="meta">Opens a private table and gives you a code to pass round.</span></span></button>`);
+  friends.onclick = () => start('cargo/create');
+  c.querySelector('.opts').append(now, friends);
+  app.appendChild(c);
+
+  const j = $(`<div class="step"><div class="lab">Or join with a code</div>
+    <input type="text" id="code" placeholder="ABC123" autocapitalize="characters" maxlength="6">
+    </div>`);
+  app.appendChild(j);
+  const d = $(`<div class="inner"><button class="go ghost">Join that table</button></div>`);
+  d.querySelector('.go').onclick = () => {
+    const code = (document.getElementById('code').value || '').trim().toUpperCase();
+    if (code.length < 4) { S.error = 'That code looks too short.'; return render(); }
+    S.code = code; start('cargo/join');
+  };
+  dock.appendChild(d);
+}
+
+async function start(route) {
+  if (S.busy) return;
+  const field = document.getElementById('name');
+  const name = ((field && field.value) || S.name || '').trim();
+  if (!name) { S.error = 'Your outfit needs a name.'; return render(); }
+  S.name = name; S.busy = true; S.error = null; render();
+  try {
+    const out = await api(route, { name });
+    S.code = out.code; S.token = out.token; S.view = out.view; save();
+    poll(3000);
+  } catch (e) { S.error = e.message; S.code = null; }
+  S.busy = false; render();
+}
+
+function screenLobby(app, dock, v) {
+  app.insertAdjacentHTML('beforeend', `<header><h1>Cargo Run</h1>
+    <div class="sub">Table ${v.code}</div></header>`);
+  let t = `<div class="card"><h2>At the table</h2><table>`;
+  v.seats.forEach((s) => { t += `<tr class="${s.you ? 'you' : ''}"><td>${s.name}</td>
+    <td class="muted">${s.you ? 'you' : 'ready'}</td></tr>`; });
+  for (let i = v.seats.length; i < (v.seats.length > 5 ? v.seats.length : 5); i++)
+    t += `<tr><td class="muted">empty</td><td class="muted">—</td></tr>`;
+  app.insertAdjacentHTML('beforeend', t + '</table></div>');
+  if (v.isPublic) {
+    /* No code here on purpose. A public table is dealt by matchmaking and the
+       server refuses a code join — the rated tier rests on nobody choosing who
+       they sit with. Offering a code would be inviting a captain to try
+       something that cannot work. */
+    const left = v.lobbyDeadline
+      ? Math.max(0, Math.round((Date.parse(v.lobbyDeadline) - Date.now()) / 1000)) : null;
+    app.insertAdjacentHTML('beforeend', `<div class="card"><h2>Waiting</h2>
+      <div class="big">${left === null ? '—' : left + 's'}</div>
+      <p class="note">Other captains are being seated here as they arrive. When the wait runs
+      out the table starts anyway and the yard's own captains take whatever seats are left —
+      nobody is told which.</p></div>`);
+    const d = $(`<div class="inner"><div class="fc"><small>Table ${v.code}</small>
+      <span class="v muted">${v.seats.length} of ${v.seats.length > 5 ? v.seats.length : 5}</span></div>
+      <button class="go" disabled>Waiting for the off</button></div>`);
+    dock.appendChild(d);
+  } else {
+    app.insertAdjacentHTML('beforeend', `<div class="card"><h2>The code</h2>
+      <div class="big">${v.code}</div>
+      <p class="note">Anyone with this can take a seat. Start when you are all here — any
+      seats still empty are taken by the yard's own captains, and nobody is told which.</p></div>`);
+    const d = $(`<div class="inner"><button class="go">Start now</button></div>`);
+    d.querySelector('.go').onclick = async () => {
+      try { const out = await api('cargo/start', {}); S.view = out.view; render(); }
+      catch (e) { S.error = e.message; render(); }
+    };
+    dock.appendChild(d);
+  }
+  poll(2500);
+}
+
+/* map: reachable spots, the lane you are flying, and where it can sell */
+function mapSVG(v) {
+  const b = v.board, you = v.you, sel = S.sel;
+  const reach = new Set(b.reachP[you.at]);
+  let g = '';
+  if (sel.p !== undefined) {
+    const a = b.drop[you.at], p = b.pick[sel.p];
+    g += `<line x1="${a.x}" y1="${a.y}" x2="${p.x}" y2="${p.y}" stroke="#f2c14e" stroke-width="0.7" stroke-dasharray="2 1.5"/>`;
+    for (const q of b.reachD[sel.p]) { const c = b.drop[q];
+      g += `<line x1="${p.x}" y1="${p.y}" x2="${c.x}" y2="${c.y}" stroke="#5fd08a" stroke-width="0.4" opacity="0.55"/>`; }
+    if (sel.d !== undefined) { const c = b.drop[sel.d];
+      g += `<line x1="${p.x}" y1="${p.y}" x2="${c.x}" y2="${c.y}" stroke="#f2c14e" stroke-width="0.9"/>`; }
+  }
+  b.pick.forEach((p) => { const on = reach.has(p.i), pick = sel.p === p.i;
+    g += `<circle cx="${p.x}" cy="${p.y}" r="${pick?2.4:1.5}" fill="${pick?'#f2c14e':on?'#5aa9ff':'#2b3a55'}"/>`; });
+  b.drop.forEach((d) => { const home = you.at === d.i, s = sel.d === d.i;
+    g += `<rect x="${d.x-2.2}" y="${d.y-2.2}" width="4.4" height="4.4" rx="0.8"
+      fill="${s?'#f2c14e':home?'#e6edf7':'#2b3a55'}"/>`;
+    g += `<text x="${d.x}" y="${d.y-3.4}" font-size="3" text-anchor="middle"
+      fill="${s||home?'#e6edf7':'#5a6d8c'}">${d.name.split(' ')[0]}</text>`; });
+  return `<svg viewBox="0 0 100 100" role="img" aria-label="galaxy map">${g}</svg>`;
+}
+
+function lastRoundCard(v) {
+  const h = (v.history || [])[0];
+  if (!h) return '';
+  const me = v.seats.findIndex((s) => s.you);
+  const mine = h.rows[me];
+  const r = v.you.lastRefit;
+  let s = `<div class="card"><h2>Last round</h2>
+    <div class="big ${cls(mine.profit)}">${money(mine.profit)}</div>
+    <p class="note">${GOODS[mine.c]} into ${v.board.drop[mine.d].name} —
+    ${mine.stackS > 1 ? `<b class="b">${mine.stackS} ships</b> sold there` : 'you had it to yourself'}.</p>`;
+  if (r) s += `<p class="note">${r.lot === null
+    ? `Outbid on every part. The yard fitted a scrap ${SLOTNAMES[r.slot]} for nothing.`
+    : `You took a ${CONDITION(r.grade)} ${SLOTNAMES[r.slot]} at ${Math.round(100*r.grade)}%${
+        r.paid > 0 ? ' for ' + money(r.paid) : ' for nothing'}.`}</p>`;
+  return s + '</div>';
+}
+
+/* ---- stage one: the yard and the manifest, filed together ---------------- */
+function screenDeclare(app, dock, v) {
+  const you = v.you, b = v.board;
+  app.insertAdjacentHTML('beforeend', head(v));
+  if (you.declared) {
+    app.insertAdjacentHTML('beforeend', `<div class="card"><h2>Filed</h2>
+      <p class="note">${GOODS[you.declared.c]} from ${b.pick[you.declared.p].name}, and your
+      bids are in. Waiting for ${v.seats.filter((s) => !s.filed).length} more.</p></div>`);
+    app.insertAdjacentHTML('beforeend', lastRoundCard(v));
+    poll(3000);
+    return;
+  }
+  app.insertAdjacentHTML('beforeend', lastRoundCard(v));
+
+  /* the yard */
+  if (v.block) {
+    const failed = v.block.failed;
+    if (S.bids.length !== v.block.grades.length) S.bids = v.block.grades.map(() => 0);
+    let sh = `<div class="card"><h2>Your ship — ${SLOTNAMES[failed]} has failed</h2><table>`;
+    you.parts.forEach((g, k) => {
+      sh += `<tr class="${k === failed ? 'you' : ''}"><td>${SLOTNAMES[k]}</td>
+        <td class="muted">${k === failed ? '' : CONDITION(g)}</td>
+        <td>${k === failed ? '<b>failed</b>' : Math.round(100*g) + '%'}</td></tr>`;
+    });
+    app.insertAdjacentHTML('beforeend', sh + `</table><p class="note" style="margin-top:8px">
+      A unit of hold returns about ${money(v.perUnit)} a round — that is what to judge every
+      bid against. The refit settles at the end of this round, out of the same purse you are
+      trading with.</p></div>`);
+
+    const step = $(`<div class="step" data-step="block"><div class="lab"><span class="n">1</span>
+      &nbsp;Sealed bids — any part fits your ${SLOTNAMES[failed]}</div><div class="opts"></div></div>`);
+    v.block.grades.forEach((g, j) => {
+      const full = v.block.worth[j];
+      const cap = Math.max(100, Math.ceil(full * 1.25 / 25) * 25);
+      const row = $(`<div class="card" style="margin:6px 0;padding:11px 12px">
+        <div style="display:flex;gap:10px;align-items:baseline">
+          <span style="flex:1">Lot ${j+1} · ${CONDITION(g)} <b>${Math.round(100*g)}%</b>
+            <br><span class="meta" style="font-size:11.5px">beats
+            ${j === v.block.grades.length-1 ? 'a scrap part' : 'Lot ' + (j+2)} by ${money(full)}</span></span>
+          <span style="text-align:right"><span class="px" id="bv${j}">—</span>
+            <br><span class="meta" id="bu${j}" style="font-size:11.5px">&nbsp;</span></span>
+        </div>
+        <input type="range" min="0" max="${cap}" step="25" value="${S.bids[j]||0}" id="bid${j}">
+      </div>`);
+      step.querySelector('.opts').appendChild(row);
+    });
+    app.appendChild(step);
+  }
+
+  app.insertAdjacentHTML('beforeend', mapSVG(v));
+
+  /* where to load */
+  const s2 = $(`<div class="step" data-step="pickup"><div class="lab"><span class="n">2</span>
+    &nbsp;Fly out to</div><div class="opts"></div></div>`);
+  b.reachP[you.at].forEach((p) => {
+    const cheapest = Math.min(...v.prices.buy[p]);
+    const serves = b.reachD[p].map((d) => b.drop[d].name.split(' ')[0]).join(' · ');
+    const btn = $(`<button class="opt tall" aria-pressed="${S.sel.p === p}">
+      <span class="nm">${b.pick[p].name}<br><span class="meta">ships to ${serves}</span></span>
+      <span class="px">${px(cheapest)}<span class="meta"> low</span></span></button>`);
+    btn.onclick = () => { S.sel = { p }; render(); };
+    s2.querySelector('.opts').appendChild(btn);
+  });
+  app.appendChild(s2);
+
+  /* what to load */
+  if (S.sel.p !== undefined) {
+    const s3 = $(`<div class="step" data-step="cargo"><div class="lab"><span class="n">3</span>
+      &nbsp;Load up on</div><div class="opts chips"></div></div>`);
+    for (let c = 0; c < 5; c++) {
+      const bp = v.prices.buy[S.sel.p][c];
+      const best = b.reachD[S.sel.p].reduce((a, d) => v.prices.sell[d][c] > v.prices.sell[a][c] ? d : a,
+                                            b.reachD[S.sel.p][0]);
+      const marg = v.prices.sell[best][c] - bp;
+      const btn = $(`<button class="opt" aria-pressed="${S.sel.c === c}">
+        <span class="nm">${GOODS[c]}<br><span class="meta">buy ${px(bp)}</span></span>
+        <span class="px ${cls(marg)}">${marg>=0?'+':'−'}${px(Math.abs(marg))}</span></button>`);
+      btn.onclick = () => { S.sel = { p: S.sel.p, c }; render(); };
+      s3.querySelector('.opts').appendChild(btn);
+    }
+    app.appendChild(s3);
+  }
+
+  const ready = S.sel.p !== undefined && S.sel.c !== undefined;
+  const d = $(`<div class="inner">
+    <div class="fc"><small id="fs">${ready ? 'Loading at ' + b.pick[S.sel.p].name : 'Pick a spot and a cargo'}</small>
+      <span class="v ${ready?'':'muted'}" id="fv">${ready ? GOODS[S.sel.c] : '—'}</span></div>
+    <button class="go" ${ready?'':'disabled'}>File manifest and bids</button></div>`);
+  d.querySelector('.go').onclick = async () => {
+    if (!ready || S.busy) return;
+    S.busy = true;
+    try {
+      const out = await api('cargo/declare', { pickup: S.sel.p, commodity: S.sel.c, bids: S.bids });
+      S.sel = {}; S.bids = []; S.busy = false;
+      return applyView(out.view);
+    } catch (e) { S.error = e.message; }
+    S.busy = false; render();
+  };
+  dock.appendChild(d);
+  if (S.error) app.insertAdjacentHTML('beforeend', `<p class="err">${S.error}</p>`);
+
+  /* live bid readouts */
+  if (v.block) {
+    const paint = () => {
+      v.block.grades.forEach((g, j) => {
+        const el = document.getElementById('bv' + j), eu = document.getElementById('bu' + j);
+        const val = S.bids[j] || 0, full = v.block.worth[j];
+        if (el) { el.textContent = val < 1 ? '—' : money(val);
+                  el.className = 'px ' + (val < 1 ? 'muted' : val > full + 1 ? 'b' : 'g'); }
