+  const openTotal = open.reduce((a, f) => a + f.share, 0);
+  const dots = [];
+  d.firms.forEach((f, i) => {
+    f.n = Math.max(1, Math.round((f.share / total) * budget));
+    /* your pile sheds the same FRACTION of itself that your books did */
+    const leaving = f.you && f.turnedFrac > 0
+      ? Math.min(f.n - 1, Math.round(f.n * f.turnedFrac)) : 0;
+    for (let k = 0; k < f.n; k++) {
+      let to = null;
