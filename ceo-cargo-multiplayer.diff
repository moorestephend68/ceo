+      <td class="muted">${x.couldSell.map((d) => b.drop[d].name.split(' ')[0]).join('<br>')}</td></tr>`;
+  });
+  app.insertAdjacentHTML('beforeend', m + '</table></div>');
+
+  const sharing = (v.manifests || []).filter((x) => !x.you && x.c === you.declared.c);
+  if (sharing.length) {
+    const where = [...new Set(sharing.flatMap((x) => x.couldSell))]
