+  const d = FILM.data;
+  if (!d || !FCOL.length) return;
+  const perRow = Math.max(3, Math.floor((FCOL[0].w - 10) / 6));
+  const rows = Math.max(6, Math.floor((FSHELF - 26 - (FSRC.y + 58)) / 7));
