+  const cy = (a.y + b.y) / 2 + (lift === undefined ? 40 : lift);
+  const v = 1 - u;
+  return { x: v * v * a.x + 2 * v * u * cx + u * u * b.x,
+           y: v * v * a.y + 2 * v * u * cy + u * u * b.y };
+}
+function filmDotAt(d, ph) {
+  const home = filmSlot(d, d.i);
+  if (ph.name === 'ladder') return null;
+  if (ph.name === 'crowd') {
+    const u = f01(ph.u * 1.5 - d.delay * 0.5);
+    if (u <= 0) return null;
+    return { ...filmBez(FSRC, home, fease(u), d.lane), turned: false };
+  }
+  if (d.to === null) return { ...home, turned: false };
+  const u = f01(ph.u * 1.7 - 0.2 - d.delay * 0.35);
+  const f = FILM.data.firms[d.to];
+  const away = filmSlot(d, d.to, f.n + (d.k % 40));
