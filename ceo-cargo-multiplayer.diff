+const after = await p.evaluate(() => PROD.t);
+ok(after >= 1 && after < 1 + 1.9 * 3, 'Next moves on one landing at a time: t = ' + after.toFixed(1));
+await p.click('#pclose');
+ok(!(await up()), 'and it hands the game back');
